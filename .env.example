# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置
# RAGFlow Web/API 若经 nginx 暴露在 80 端口，用 http://localhost；直连后端再用 :9380
RAGFLOW_API_URL=http://localhost
RAGFLOW_API_KEY=ragflow-your-api-key

# 向量检索配置 (ChromaDB + OpenAI Embedding)
# 如果你的 LLM 提供商（如 DeepSeek）不支持 Embedding，需要单独配置 Embedding API
# EMBEDDING_API_KEY=你的Embedding_API_KEY      # 不设置则回退到 API_KEY
# EMBEDDING_BASE_URL=https://xxx.com/v1        # 不设置则回退到 BASE_URL
# EMBEDDING_MODEL=text-embedding-3-large       # Embedding 模型名（需提供商支持）
# CHROMA_PERSIST_DIR=./chroma_db
# VECTOR_SEARCH_TOP_K=10
# VECTOR_SEARCH_VARIANTS=3

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# 如果本机已有 MySQL 占用 3306，可改为 3307，同时修改 docker/.env
MYSQL_PORT=3306
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
